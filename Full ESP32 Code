#ESP32 Spelling Bee Game
#Challenge your spelling skills with common words that are surprisingly tricky to spell!

#-----Libraries-----

import network
import socket
import machine
import time
import ure
import urequests
import uio
import sys

#-----Hardware-----

button = machine.Pin(22, machine.Pin.IN, machine.Pin.PULL_UP)
buzzer = machine.Pin(21, machine.Pin.OUT)
green_led = machine.Pin(4, machine.Pin.OUT)
red_led = machine.Pin(18, machine.Pin.OUT)

#-----Sound Functions-----

def tone(freq, duration):
    if freq == 0:
        buzzer.value(0) #Start with buzzer OFF
        time.sleep_ms(duration)
        return
    pwm = machine.PWM(buzzer)
    pwm.freq(freq) #Set frequencies to freq Hz
    pwm.duty(512)
    time.sleep_ms(duration) #Play tone for certain time duration
    pwm.deinit() #Stop PWM; silence the buzzer

def happy_sound():
    melody = [600, 800, 1000]
    for f in melody:
        tone(f, 150)
        time.sleep_ms(50)

def sad_sound():
    melody = [800, 600, 400]
    for f in melody:
        tone(f, 200)
        time.sleep_ms(50)

