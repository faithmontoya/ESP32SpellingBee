#-----PC-Side Code-----
# Saved as "pc_tts_server.py" and ran on Bash 
# Needs to run on PC PRIOR to running ESP32 script
# Run using command "python pc_tts_server.py"

from flask import Flask, request
import threading
import queue
import subprocess

app = Flask(__name__)

speech_queue = queue.Queue()

def tts_worker():
    while True:
        word = speech_queue.get()
        if word is None:
            break

        print(f"[PC] Speaking: {word}") #Confirm tts function on PC-side

        # Use Windows built-in TTS (never freezes)
        subprocess.run([
            "powershell",
            "-Command",
            (
            f"Add-Type –AssemblyName System.Speech; " +
            f"$speak = New-Object System.Speech.Synthesis.SpeechSynthesizer; " +
            f"$speak.Speak('{word}');"
            )
        ])

        speech_queue.task_done()

thread = threading.Thread(target=tts_worker, daemon=True)
thread.start()

@app.route("/say") #"say" url 
def say():
    word = request.args.get("word", "")
    if word:
        speech_queue.put(word)
        return "OK", 200
    return "No word provided", 400

if __name__ == "__main__":
    print("PC TTS server running on port 5000...")
    print("Waiting for ESP32 requests...")
    app.run(host="0.0.0.0", port=5000)

