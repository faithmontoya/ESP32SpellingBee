from flask import Flask, request
import pyttsx3

app = Flask(__name__)
engine = pyttsx3.init()

@app.route("/say")
def say():
    word = request.args.get("word", "")
    if word:
        engine.say(word)
        engine.runAndWait()
        return "OK"
    return "No word provided"

app.run(host="0.0.0.0", port=5000)
